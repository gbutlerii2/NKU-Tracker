rules_version = '2';

// North Kitsap United Tracker — Firestore rules.
//
// Access lives in /users/{email} (the document id IS the lowercased email
// address, so rules can look the caller up straight from their auth token).
//
// Each user holds roles (bundles of operations, defined in meta/roles) plus
// extra operations. The app writes the effective result to users/{email}.perms:
//   perms.<section>  'none' | 'view' | 'write'   for overview, donors,
//                    transactions, events, phases, workers, tasks, admin,
//                    reports, documents, calendar
//   perms.wsdonors / wsdonations / wsgrants  'none' | 'write'  entry workspaces
//                    ('edit' = Enter and edit, Donors and Donations only)
//   perms.money      true | false                 View $$
// Only admins hold the full-tracker sections; everyone else works through the
// entry workspaces (the app's permsFor turns the other sections off).
// Writes to a collection need 'write' on its section; perms.admin == 'write'
// is full admin. Section visibility is enforced in the app — the Overview,
// Reports and Calendar roll up every collection, so records stay readable to
// any active signed-in user. Amounts are enforced here.
//
// Accounts that predate operations (a single 'role' field, no perms) keep
// their old access until an admin signs in, which migrates them.
//
// Amounts are not fields on the records. Every money value (donor proposed
// amount, donation amount, phase budget, worker rate, task cost and cost rows)
// lives in a per-record `secure/v` subcollection document. View Only Limited is
// denied read on that whole collection group, so those numbers never reach the
// device at all — nothing is merely hidden in the interface. Raising a user's
// role takes effect live; the app re-subscribes and the amounts arrive.

service cloud.firestore {
  match /databases/{database}/documents {

    // BOOTSTRAP — these addresses are Admin before any roster exists, and stay
    // a lockout escape hatch afterwards. Mirror in firebase-sync.js.
    function bootstrapAdmin() {
      return signedIn() && myEmail() in [
        'gerry@gb2solutions.net',
        'gerandkar@gmail.com'
      ];
    }

    // Any Firebase login, before the texted code. Only enough to read and
    // update one's own roster entry while finishing first-time setup.
    function loggedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    // Signed in with password AND a texted code (multi-factor), on an account
    // an admin has added. Everything else in the database requires this.
    function mfa() {
      return request.auth.token.firebase.get('sign_in_second_factor', null) == 'phone';
    }
    function signedIn() {
      return loggedIn() && mfa();
    }
    function member() {
      return bootstrapAdmin() || activeUser();
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function myPath() {
      return /databases/$(database)/documents/users/$(myEmail());
    }
    function hasProfile() {
      return signedIn() && exists(myPath());
    }
    function me() {
      return get(myPath()).data;
    }
    function activeUser() {
      return hasProfile() && me().active != false;
    }
    function hasPerms() {
      return me().get('perms', null) != null;
    }
    function legacyRole() {
      return me().get('role', '');
    }
    function isAdmin() {
      return bootstrapAdmin() || (activeUser() && (hasPerms()
        ? me().perms.get('admin', 'none') == 'write'
        : legacyRole() == 'Admin'));
    }
    // May create / edit records belonging to this section.
    function canWrite(sec) {
      return isAdmin() || (activeUser() && (hasPerms()
        ? me().perms.get(sec, 'none') == 'write'
        : (legacyRole() == 'Entry User' && sec in ['donors', 'transactions', 'events', 'documents'])));
    }
    // Who may receive a single dollar figure.
    function canSeeMoney() {
      return isAdmin() || (activeUser() && (hasPerms()
        ? me().perms.get('money', false) == true
        : legacyRole() in ['View Only Full', 'Entry User']));
    }
    // Holds an entry workspace (Donor entry, Donation entry, Grant tracking),
    // at either level: 'write' (Enter only) or 'edit' (Enter and edit).
    function ws(op) {
      return activeUser() && hasPerms() && me().perms.get(op, 'none') in ['write', 'edit'];
    }
    // Enter and edit: may also change existing records from the workspace.
    function wsEdit(op) {
      return activeUser() && hasPerms() && me().perms.get(op, 'none') == 'edit';
    }
    function grantDoc(d) {
      return d.get('method', '').lower() == 'grant award';
    }
    function txPath(id) {
      return /databases/$(database)/documents/transactions/$(id);
    }
    // Donation entry may create non-grant donations and afterwards only mark
    // the thank-you; at Enter and edit it may change them (including applying
    // a donation to a pledge and the pledge's balance). Grant tracking may
    // create and edit grant awards. None may delete, and none may turn one
    // kind into the other.
    function wsTxCreate() {
      return (ws('wsdonations') && !grantDoc(request.resource.data))
        || (ws('wsgrants') && grantDoc(request.resource.data));
    }
    function wsTxUpdate() {
      return (ws('wsdonations') && !grantDoc(resource.data) && !grantDoc(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thankedAt', 'thankedBy']))
        || (wsEdit('wsdonations') && !grantDoc(resource.data) && !grantDoc(request.resource.data))
        || (ws('wsgrants') && grantDoc(resource.data) && grantDoc(request.resource.data));
    }
    function anyRecordWrite() {
      return canWrite('donors') || canWrite('transactions') || canWrite('events');
    }

    // ---- records (no amounts in these documents) ----------------------------

    match /donors/{id} {
      allow read: if member();
      allow write: if canWrite('donors');
      // Donors workspace, and the Donations / Grants workspaces adding a new
      // donor or funder along with a gift or grant.
      allow create: if ws('wsdonors') || ws('wsdonations') || ws('wsgrants');
      // Donors workspace at Enter and edit changes donors' details.
      allow update: if wsEdit('wsdonors');
    }
    match /transactions/{id} {
      allow read: if member();
      allow write: if canWrite('transactions');
      allow create: if wsTxCreate();
      allow update: if wsTxUpdate();
    }
    match /events/{id} {
      allow read: if member();
      allow write: if canWrite('events');
    }
    match /phases/{id} {
      allow read: if member();
      allow write: if canWrite('phases');
    }
    match /workers/{id} {
      allow read: if member();
      allow write: if canWrite('workers');
    }
    match /tasks/{id} {
      allow read: if member();
      allow write: if canWrite('tasks');
    }
    // Documents section — uploaded file records (no amounts).
    match /docs/{id} {
      allow read: if member();
      allow write: if canWrite('documents');
    }

    // ---- amounts ------------------------------------------------------------
    // The recursive path is required: a collection-group query on `secure` can
    // only be authorized by a rule whose path starts with a recursive wildcard.
    match /{path=**}/secure/{doc} {
      allow read: if canSeeMoney();
    }
    // Writes stay scoped per collection, matching who may edit each record.
    match /donors/{id}/secure/{doc} {
      allow write: if canWrite('donors');
    }
    match /transactions/{id}/secure/{doc} {
      allow write: if canWrite('transactions');
      // The amount typed when a workspace user enters a gift. Create only:
      // they can't read it back or change it afterwards.
      allow create: if existsAfter(txPath(id)) && (
        (ws('wsdonations') && !grantDoc(getAfter(txPath(id)).data))
        || (ws('wsgrants') && grantDoc(getAfter(txPath(id)).data)));
      // Grant details aren't private: Grant tracking reads and edits the
      // amount of a grant award, one document at a time.
      allow read, update: if ws('wsgrants') && grantDoc(get(txPath(id)).data);
      // Donations workspace at Enter and edit: the amount of a non-grant
      // donation, and a pledge's open balance when a donation is applied.
      allow create, update: if wsEdit('wsdonations') && exists(txPath(id)) && !grantDoc(get(txPath(id)).data);
    }
    match /events/{id}/secure/{doc} {
      allow write: if canWrite('events');
    }
    match /phases/{id}/secure/{doc} {
      allow write: if canWrite('phases');
    }
    match /workers/{id}/secure/{doc} {
      allow write: if canWrite('workers');
    }
    match /tasks/{id}/secure/{doc} {
      allow write: if canWrite('tasks');
    }
    match /docs/{id}/secure/{doc} {
      allow write: if canWrite('documents');
    }

    // ---- configuration ------------------------------------------------------
    // Data fields, select choices, managed lists, roles, reminders, contact log.
    match /meta/{doc} {
      allow read: if member();
      allow write: if isAdmin() || (anyRecordWrite() && doc in ['reminders', 'contacts']);
    }

    // ---- admin-only settings ---------------------------------------------------
    // private/email holds the receipt email settings, including the provider's
    // API key. Only admins (and the Netlify function, via the Admin SDK) see it.
    match /private/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- roster -------------------------------------------------------------
    // Invitation only: admins create every entry. Anyone logged in may read
    // and touch their own (password change, last sign-in) while finishing
    // setup, but nobody may change their own access.
    match /users/{email} {
      allow read: if member() || (loggedIn() && email == myEmail());
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (loggedIn() && email == myEmail()
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['roles', 'ops', 'perms', 'role', 'active']));
      allow delete: if isAdmin();
    }
  }
}
